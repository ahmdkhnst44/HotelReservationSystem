@model RegisterViewModel
@{
    ViewData["Title"] = L["Register"];
}
<section class="auth-page">
    <div class="container">
        <div class="auth-shell surface-card register-shell">
            <div class="auth-visual register-visual">
                <div class="auth-visual-content">
                    <span class="brand-mark auth-brand">A</span>
                    <span class="section-kicker">JOIN AURORA</span>
                    <h1>@L["CreateAccountText"]</h1>
                    <p>@L["FeatureTwoText"]</p>
                    <div class="auth-points"><span>✓ @L["FeatureOneTitle"]</span><span>✓ @L["MyBookingsButton"]</span><span>✓ @L["FeatureThreeTitle"]</span></div>
                </div>
            </div>
            <div class="auth-form-panel">
                <div class="auth-heading"><span class="section-kicker">NEW ACCOUNT</span><h2>@L["Register"]</h2><p>@L["CreateAccountText"]</p></div>
                <form asp-action="Register" method="post" class="stacked-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <div class="form-field"><label asp-for="FullName">@L["FullName"]</label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="field-validation"></span></div>
                    <div class="form-field"><label asp-for="Email">@L["Email"]</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="field-validation"></span></div>
                    <div class="form-grid two-columns compact-grid">
                        <div class="form-field"><label asp-for="Password">@L["Password"]</label><div class="password-field"><input asp-for="Password" class="form-control" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle aria-label="Show password">◉</button></div><span asp-validation-for="Password" class="field-validation"></span></div>
                        <div class="form-field"><label asp-for="ConfirmPassword">@L["ConfirmPassword"]</label><div class="password-field"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle aria-label="Show password">◉</button></div><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div>
                    </div>
                    <button class="btn btn-primary btn-lg w-100" type="submit">@L["Register"]</button>
                </form>
                <p class="auth-switch">@L["HaveAccount"] <a asp-action="Login">@L["Login"]</a></p>
            </div>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
