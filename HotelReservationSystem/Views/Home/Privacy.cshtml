@{
    ViewData["Title"] = L["About"];
}
<section class="content-section page-top">
    <div class="container narrow-container">
        <div class="about-hero surface-card">
            <span class="about-icon">A</span>
            <span class="section-kicker">HOTEL RESERVATION SYSTEM</span>
            <h1>@L["AboutTitle"]</h1>
            <p>@L["AboutText"]</p>
            <p>@L["AboutGoal"]</p>
        </div>

        <div class="demo-card surface-card">
            <div><span class="section-kicker">DEMO</span><h2>@L["DemoAccounts"]</h2></div>
            <div class="demo-accounts">
                <div><strong>@L["AdminAccount"]</strong><code>admin@hotel.local</code><code>Admin123</code></div>
                <div><strong>@L["CustomerAccount"]</strong><code>guest@hotel.local</code><code>Guest123</code></div>
            </div>
        </div>
    </div>
</section>
